<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>fr.ign.validator</groupId>
		<artifactId>validator</artifactId>
		<version>4.7.3-SNAPSHOT</version>
	</parent>
	<name>validator-cli</name>
	<artifactId>validator-cli</artifactId>
	<packaging>jar</packaging>


	<dependencies>
		<!-- core -->
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>validator-core</artifactId>
			<version>${project.parent.version}</version>
			<scope>compile</scope>
		</dependency>

		<!-- cnig -->
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>validator-plugin-cnig</artifactId>
			<version>${project.parent.version}</version>
			<scope>compile</scope>
		</dependency>

		<!-- dgpr -->
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>validator-plugin-dgpr</artifactId>
			<version>${project.parent.version}</version>
			<scope>compile</scope>
		</dependency>

		<!-- PCRS -->
		<dependency>
			<groupId>${project.parent.groupId}</groupId>
			<artifactId>validator-plugin-pcrs</artifactId>
			<version>${project.parent.version}</version>
			<scope>compile</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>${project.artifactId}</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<!-- Invalid signature file digest for Manifest main attributes -->
							<!-- GeoTools transitive dependencies not used by the validator (image processing : Eclipse ImageN, formerly JAI ; OGC XML models are excluded in the parent pom) -->
							<artifactSet>
								<excludes>
									<exclude>org.eclipse.imagen:*</exclude>
								</excludes>
							</artifactSet>
							<filters>
								<!-- keep SQLite native libraries for Linux (glibc and musl), Mac and Windows x86_64 -->
								<filter>
									<artifact>org.xerial:sqlite-jdbc</artifact>
									<excludes>
										<exclude>org/sqlite/native/FreeBSD/**</exclude>
										<exclude>org/sqlite/native/Linux/arm*/**</exclude>
										<exclude>org/sqlite/native/Linux/ppc64/**</exclude>
										<exclude>org/sqlite/native/Linux/riscv64/**</exclude>
										<exclude>org/sqlite/native/Linux/x86/**</exclude>
										<exclude>org/sqlite/native/Linux-Musl/x86/**</exclude>
										<exclude>org/sqlite/native/Linux-Musl/aarch64/**</exclude>
										<exclude>org/sqlite/native/Windows/x86/**</exclude>
										<exclude>org/sqlite/native/Windows/arm*/**</exclude>
										<exclude>org/sqlite/native/Windows/aarch64/**</exclude>
									</excludes>
								</filter>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>module-info.class</exclude>
										<exclude>META-INF/versions/**/module-info.class</exclude>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<!-- the manifest of validator-cli.jar is created by ManifestResourceTransformer -->
										<exclude>META-INF/MANIFEST.MF</exclude>
									</excludes>
								</filter>
							</filters>
							<!-- /Invalid signature file digest for Manifest main attributes -->
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>fr.ign.validator.Application</mainClass>
									<manifestEntries>
										<Multi-Release>true</Multi-Release>
									</manifestEntries>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
								<!-- overlapping resources of the dependencies : license texts concatenated (Apache, BSD, MIT...), NOTICE files merged -->
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/LICENSE</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/LICENSE.txt</resource>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
									<addHeader>false</addHeader>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/DEPENDENCIES</resource>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
